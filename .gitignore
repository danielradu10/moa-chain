# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Local service process files
.agent.pid
.ollama.pid
.experiment-agents.pid

# Local multi-agent cluster logs and PID files (any subdir, any name)
logs/

# Generated integration-test validator logs
integrationtests/logs/
integrationtests/testData/**/results/*.jsonl
integrationtests/testData/miniround2/scenarios/*/result.json

# Distributed test results — ignore raw logs, JSON, and JSONL run data, keep analysis docs (README.md)
testresults/*.json
testresults/*.log
testresults/agent-logs/
experiment-results/
benchmark_results/
agent-python/testresults/agent-qualification/*.json
agent-python/testresults/real-agents/*/

# Cluster infrastructure — contains internal IPs in machine table
DISTRIBUTED_TESTING.md

# Dissertation PDFs
_BCAA_2026__Blockchain_AI.pdf
_BCCA_2026__Blockchain_AI*.pdf
IBCOL_2026.pdf

# Editor/IDE
.DS_Store
.idea/
# .vscode/
