# ── Provider selection ────────────────────────────────────────────────────────
# Supported values: "ollama" (default), "openai"
LLM_PROVIDER=ollama

# ── Ollama settings (used when LLM_PROVIDER=ollama) ──────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Ollama-specific generation bounds
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=256
LLM_THINK=false

# ── OpenAI settings (used when LLM_PROVIDER=openai) ──────────────────────────
# OPENAI_API_KEY is required when LLM_PROVIDER=openai; startup fails without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic settings (used when LLM_PROVIDER=anthropic) ────────────────────
# ANTHROPIC_API_KEY is required when LLM_PROVIDER=anthropic; startup fails without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Maximum tokens Anthropic may generate per call (required by the API).
ANTHROPIC_MAX_TOKENS=4096

# ── Shared LLM settings ───────────────────────────────────────────────────────
# Sampling temperature.
# 0.0 = deterministic (defeats MoA diversity). 0.5 = recommended default.
LLM_TEMPERATURE=0.5

# Per-request timeout in seconds applied to every individual LLM call.
LLM_TIMEOUT_SECONDS=60.0

# ── Concurrency limits ────────────────────────────────────────────────────────
# Maximum number of LLM calls in-flight at the same time per operation.
# For Ollama: set OLLAMA_NUM_PARALLEL on the Ollama process to the same value.
LABEL_MAX_CONCURRENCY=4
ANSWER_MAX_CONCURRENCY=4
JUDGE_MAX_CONCURRENCY=4
